rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function sameUser(userId) {
      return signedIn() && (
        userId == request.auth.uid
        || userId == request.auth.token.get('clerkId', '')
        || userId == request.auth.token.get('replitId', '')
        || userId == request.auth.token.get('pgId', null)
      );
    }

    function isPublicMediaFolder(folder) {
      return folder.matches('^(galleries|image_galleries|artist-references|artist-profile-images|artist-profiles|artist-banner-images|generated-images|artist_music|videos|images|songs|merchandise|reference-images|promo-clips)$');
    }

    function isAdminOnlyFolder(folder) {
      return folder == 'challenge-refs';
    }

    function validUpload(folder) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 50 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size <= 200 * 1024 * 1024)
          || (request.resource.contentType == 'application/pdf' && request.resource.size <= 25 * 1024 * 1024)
          || (request.resource.contentType.matches('application/.*') && request.resource.size <= 200 * 1024 * 1024)
          || (request.resource.contentType.matches('text/.*') && request.resource.size <= 25 * 1024 * 1024)
        );
    }

    // Artist and user uploads use a stable owner directory. Media that is
    // published on profiles remains publicly readable; other owned files do not.
    match /{folder}/{userId}/{allPaths=**} {
      allow read: if isPublicMediaFolder(folder) || sameUser(userId);
      allow create, update: if !isAdminOnlyFolder(folder) && sameUser(userId) && validUpload(folder);
      allow delete: if !isAdminOnlyFolder(folder) && sameUser(userId);
    }

    // Nested generation assets store the owner in the third path segment.
    match /music-videos/{assetType}/{userId}/{allPaths=**} {
      allow read: if sameUser(userId);
      allow create, update: if sameUser(userId) && validUpload('music-videos');
      allow delete: if sameUser(userId);
    }

    // Artist profile galleries are intentionally public after upload.
    match /galleries/{artistId}/{fileName} {
      allow read: if true;
      allow create, update: if sameUser(artistId)
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sameUser(artistId);
    }

    // Administrative challenge references are uploaded only by staff.
    match /challenge-refs/{adminUid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.token.get('admin', false) == true
        && sameUser(adminUid)
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn()
        && request.auth.token.get('admin', false) == true
        && sameUser(adminUid);
    }

    // No catch-all allow: any path without an owner-aware rule is denied.
  }
}
