rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function sameUser(value) {
      return signedIn() && value != null && (
        value == request.auth.uid
        || value == request.auth.token.get('clerkId', '')
        || value == request.auth.token.get('replitId', '')
        || value == request.auth.token.get('pgId', null)
      );
    }

    function owns(data) {
      return data is map && (
        sameUser(data.get('userId', null))
        || sameUser(data.get('user_id', null))
        || sameUser(data.get('uid', null))
        || sameUser(data.get('ownerId', null))
        || sameUser(data.get('ownerUid', null))
        || sameUser(data.get('createdBy', null))
        || sameUser(data.get('created_by', null))
        || sameUser(data.get('uploadedBy', null))
        || sameUser(data.get('artistId', null))
        || sameUser(data.get('artist_id', null))
        || sameUser(data.get('authorId', null))
        || sameUser(data.get('senderId', null))
        || sameUser(data.get('recipientId', null))
        || (signedIn() && data.get('participants', {}).get(request.auth.uid, false) == true)
      );
    }

    function collaborator(data) {
      return signedIn() && data is map
        && data.get('collaborators', {}).get(request.auth.uid, false) == true;
    }

    function serverOnlyPath(path) {
      return path.matches('^artists/[^/]+/(whatsappSessions|whatsappContacts|whatsappMessages|whatsappCampaigns|aiCommands|whatsappSales|whatsappAuditLog|telegramBots|telegramUsers|telegramMessages|telegramCampaigns|telegramCommunities|telegramAICommands|telegramSales|telegramAuditLog|redditConfig|redditIntel|redditReports|redditAuditLog|discordGuilds|discordConfig|discordChannels|discordRoles|discordMembers|discordCampaigns|discordEvents|discordRewards|discordAICommands|discordModeration|discordAuditLog)/.*$');
    }

    function keepsOwnership(oldData, newData) {
      return newData.get('userId', null) == oldData.get('userId', null)
        && newData.get('user_id', null) == oldData.get('user_id', null)
        && newData.get('uid', null) == oldData.get('uid', null)
        && newData.get('ownerId', null) == oldData.get('ownerId', null)
        && newData.get('ownerUid', null) == oldData.get('ownerUid', null)
        && newData.get('createdBy', null) == oldData.get('createdBy', null)
        && newData.get('created_by', null) == oldData.get('created_by', null)
        && newData.get('artistId', null) == oldData.get('artistId', null)
        && newData.get('artist_id', null) == oldData.get('artist_id', null);
    }

    // Public artist-facing content. Only its creator can mutate it.
    match /image_galleries/{galleryId} {
      allow read: if true;
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /artist_profiles/{profileId} {
      allow read: if true;
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /shows/{showId} {
      allow read: if true;
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /songs/{songId} {
      allow read: if true;
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /artist_music/{songId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    // Account records are private, including profile documents that contain
    // contact details. Public artist profiles are served by the public API.
    match /users/{userId} {
      allow read, write: if sameUser(userId);
    }
    match /userProfiles/{userId} {
      allow read, write: if sameUser(userId);
    }
    match /users/{userId}/metrics/{metricId} {
      allow read, write: if sameUser(userId);
    }

    match /courses/{courseId} {
      allow read: if resource.data.isPublished == true || owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /course_progress/{progressId} {
      allow read: if signedIn() && progressId.matches(request.auth.uid + '_.*');
      allow create: if signedIn()
        && progressId.matches(request.auth.uid + '_.*');
      allow update: if signedIn()
        && progressId.matches(request.auth.uid + '_.*')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedLessons', 'completedExams', 'currentLesson',
          'lastAccessedAt', 'generatedImages', 'lessonImages',
          'timeSpent', 'lastCompletedAt', 'lessonContents', 'examScores'
        ]);
      allow delete: if signedIn()
        && progressId.matches(request.auth.uid + '_.*');
    }

    // These production resources are collaborative, but membership must
    // already exist on the stored record; a caller cannot grant themselves access.
    match /production_projects/{projectId} {
      allow read: if owns(resource.data) || collaborator(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if (owns(resource.data) || collaborator(resource.data))
        && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /production_phases/{phaseId} {
      allow read: if owns(resource.data) || collaborator(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if (owns(resource.data) || collaborator(resource.data))
        && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /production_tasks/{taskId} {
      allow read: if owns(resource.data) || collaborator(resource.data)
        || (signedIn() && resource.data.get('assignedTo', '') == request.auth.uid);
      allow create: if owns(request.resource.data);
      allow update: if (owns(resource.data) || collaborator(resource.data)
          || (signedIn() && resource.data.get('assignedTo', '') == request.auth.uid))
        && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /production_notes/{noteId} {
      allow read: if owns(resource.data) || collaborator(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /version_control/{versionId} {
      allow read: if owns(resource.data) || collaborator(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if (owns(resource.data) || collaborator(resource.data))
        && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /version_feedback/{feedbackId} {
      allow read: if owns(resource.data) || collaborator(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /production_files/{fileId} {
      allow read: if owns(resource.data) || collaborator(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if (owns(resource.data) || collaborator(resource.data))
        && keepsOwnership(resource.data, request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /musicVideoProjects/{projectId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    // Backend-only messaging and integration credentials. These explicit
    // denials are also excluded from the generic owner rule below.
    match /artists/{artistId}/whatsappSessions/{docId} { allow read, write: if false; }
    match /artists/{artistId}/whatsappContacts/{docId} { allow read, write: if false; }
    match /artists/{artistId}/whatsappMessages/{docId} { allow read, write: if false; }
    match /artists/{artistId}/whatsappCampaigns/{docId} { allow read, write: if false; }
    match /artists/{artistId}/aiCommands/{docId} { allow read, write: if false; }
    match /artists/{artistId}/whatsappSales/{docId} { allow read, write: if false; }
    match /artists/{artistId}/whatsappAuditLog/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramBots/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramUsers/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramMessages/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramCampaigns/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramCommunities/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramAICommands/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramSales/{docId} { allow read, write: if false; }
    match /artists/{artistId}/telegramAuditLog/{docId} { allow read, write: if false; }
    match /artists/{artistId}/redditConfig/{docId} { allow read, write: if false; }
    match /artists/{artistId}/redditIntel/{docId} { allow read, write: if false; }
    match /artists/{artistId}/redditReports/{docId} { allow read, write: if false; }
    match /artists/{artistId}/redditAuditLog/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordGuilds/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordConfig/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordChannels/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordRoles/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordMembers/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordCampaigns/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordEvents/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordRewards/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordAICommands/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordModeration/{docId} { allow read, write: if false; }
    match /artists/{artistId}/discordAuditLog/{docId} { allow read, write: if false; }

    // Other user-owned app data. Public visibility or server-only access must
    // be explicitly declared above; unknown documents default to deny.
    match /{document=**} {
      allow read: if !serverOnlyPath(document) && owns(resource.data);
      allow create: if !serverOnlyPath(document) && owns(request.resource.data);
      allow update: if !serverOnlyPath(document)
        && owns(resource.data)
        && owns(request.resource.data);
      allow delete: if !serverOnlyPath(document) && owns(resource.data);
    }
  }
}
